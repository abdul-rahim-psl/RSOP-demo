---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GlossaryPopovers from '../components/GlossaryPopovers.astro';

interface Props {
  title?: string;
  description?: string;
  /** Flow pages fill the viewport like an app; their footer lives inside the scrolling stage. */
  app?: boolean;
}

const site = 'Bill pay, explained';
const { title, description = 'An interactive guide to how a government bill is looked up and paid over Raast, Pakistan’s instant payment system.', app = false } = Astro.props;
const pageTitle = title ? `${title} · ${site}` : `${site} · How a bill gets paid on Raast`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Runs before first paint, so a saved light theme never flashes dark first.
      try {
        if (localStorage.getItem('rsop-theme') === 'light') document.documentElement.dataset.theme = 'light';
      } catch {}
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/nunito.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/eb-garamond.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class:list={{ app }}>
    <Header />
    <slot />
    {!app && <Footer />}
    <GlossaryPopovers />
  </body>
</html>
