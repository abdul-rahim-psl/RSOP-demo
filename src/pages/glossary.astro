---
import Base from '../layouts/Base.astro';
import { glossary, glossaryGroups } from '../data/glossary';
import { sources } from '../data/sources';

const mojaloop = [
  ['Raast hub', 'Mojaloop Hub (the switch)'],
  ['Participant: bank, MFB or EMI', 'DFSP'],
  ['pacs.008 sent to Raast', 'Transfer prepare, POST /transfers'],
  ['Check the cap and block funds', 'Position check against the Net Debit Cap, and reservation'],
  ['Receiving side approves: pacs.002 AUTH', 'Payee DFSP fulfils, PUT /transfers'],
  ['ACSP sent to both sides', 'The hub’s commit notifications'],
  ['Debit cap backed by a reserve at SBP', 'Net Debit Cap backed by deposited liquidity'],
  ['Cut-off, net batch, PRISM+', 'Settlement window, settlement, RTGS'],
];
---

<Base title="Glossary" description="Every term in the guide, in plain words, with where it comes from.">
  <main class="wrap page">
    <header class="page-head">
      <p class="eyebrow">Reference</p>
      <h1 class="headline">Glossary<span class="pd">.</span></h1>
      <p class="lede">Every term in the guide, in plain words. Tap a dotted word anywhere in the guide to open its entry here.</p>
      <label class="search glass">
        <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.6"></circle><path d="m10.6 10.6 3.4 3.4"></path></svg>
        <input type="search" placeholder="Search terms, e.g. ACSP or settlement" aria-label="Search the glossary" data-search />
        <span class="count mono" data-count>{glossary.length} terms</span>
      </label>
    </header>

    <div class="groups">
      {
        glossaryGroups.map((g) => (
          <section class="group" data-group>
            <h2 class="seclabel">{g}</h2>
            <div class="cards">
              {glossary
                .filter((t) => t.group === g)
                .map((t) => (
                  <article class="term-card glass" id={t.id} data-text={`${t.term} ${t.meaning}`.toLowerCase()}>
                    <h3>{t.term}</h3>
                    <p>{t.meaning}</p>
                    <p class="src">{sources[t.source].label}</p>
                  </article>
                ))}
            </div>
          </section>
        ))
      }
      <p class="empty" hidden data-empty>No term matches. Try a shorter word.</p>
    </div>

    <section class="mojaloop" aria-labelledby="ml">
      <h2 id="ml" class="h2">If you know Mojaloop<span class="pd">.</span></h2>
      <p class="lede">Raast’s payment flow is close to Mojaloop’s transfer flow. A rough map, from the Raast learning notes:</p>
      <div class="map glass">
        <div class="mrow head"><span>Raast</span><span>Mojaloop</span></div>
        {
          mojaloop.map(([a, b]) => (
            <div class="mrow">
              <span>{a}</span>
              <span>{b}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="sources" id="sources" aria-labelledby="src-h">
      <h2 id="src-h" class="h2">Sources<span class="pd">.</span></h2>
      <p class="lede">
        The two flows follow the demo doc step for step. Background facts come from the Raast learning notes, which cite
        their own sources. Where the guide adds detail from Raast’s design spec, the step says so.
      </p>
      <dl>
        {
          Object.values(sources).map((s) => (
            <div class="glass">
              <dt>{s.label}</dt>
              <dd>{s.detail}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </main>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-search]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
      let inGroup = 0;
      g.querySelectorAll<HTMLElement>('[data-text]').forEach((card) => {
        const hit = !q || card.dataset.text!.includes(q);
        card.hidden = !hit;
        if (hit) inGroup++;
      });
      g.hidden = inGroup === 0;
      shown += inGroup;
    });
    if (count) count.textContent = `${shown} term${shown === 1 ? '' : 's'}`;
    if (empty) empty.hidden = shown > 0;
  });
</script>

<style>
  .page {
    padding-top: 44px;
  }

  .page-head {
    display: grid;
    gap: 14px;
    padding-bottom: 34px;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 560px;
    margin-top: 8px;
    padding: 4px 16px;
    border-radius: 999px;
  }

  .search svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: var(--mut);
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .search input {
    flex: 1;
    min-width: 0;
    height: 42px;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    outline: none;
  }

  .search:focus-within {
    border-color: var(--accent);
  }

  .count {
    font-size: 0.74rem;
    color: var(--faint);
    white-space: nowrap;
  }

  .groups {
    display: grid;
    gap: 40px;
  }

  .group {
    display: grid;
    gap: 14px;
  }

  .group[hidden] {
    display: none;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
  }

  .term-card {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 16px 18px;
    scroll-margin-top: calc(var(--header-h) + 20px);
  }

  .term-card[hidden] {
    display: none;
  }

  .term-card:target {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  h3 {
    font-size: 1.1rem;
    font-weight: 900;
  }

  .term-card p {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .term-card .src {
    font-size: 0.72rem;
    color: var(--faint);
  }

  .empty {
    color: var(--mut);
  }

  .mojaloop,
  .sources {
    display: grid;
    gap: 14px;
    margin-top: 72px;
    scroll-margin-top: calc(var(--header-h) + 20px);
  }

  .map {
    overflow: hidden;
  }

  .mrow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding: 10px 18px;
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  .mrow + .mrow {
    border-top: 1px solid var(--stroke);
  }

  .mrow.head {
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  dl {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 12px;
  }

  dl div {
    display: grid;
    gap: 6px;
    padding: 16px 18px;
  }

  dt {
    font-weight: 900;
  }

  dd {
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  @media (max-width: 520px) {
    .mrow {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .mrow span:last-child {
      color: var(--mut);
    }
  }
</style>
