---
// Six banks on a hexagon: wired to each other, or each wired once to a hub.
const cx = 160;
const cy = 118;
const r = 88;
const banks = Array.from({ length: 6 }, (_, i) => {
  const a = ((-90 + i * 60) * Math.PI) / 180;
  return { x: cx + r * Math.cos(a), y: cy + r * Math.sin(a), name: 'ABCDEF'[i] };
});
const pairs = banks.flatMap((a, i) => banks.slice(i + 1).map((b) => [a, b] as const));
---

<figure class="hub glass">
  <div class="toggle" role="radiogroup" aria-label="Connect the banks">
    <input type="radio" name="hub-mode" id="hub-mesh" value="mesh" checked />
    <label for="hub-mesh">Without a hub</label>
    <input type="radio" name="hub-mode" id="hub-star" value="star" />
    <label for="hub-star">With a hub</label>
  </div>

  <svg viewBox="0 0 320 236" role="img" aria-label="Six banks: fifteen direct links without a hub, six links with one">
    <g class="mesh">
      {pairs.map(([a, b]) => <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} />)}
    </g>
    <g class="star">
      {banks.map((b) => <line x1={cx} y1={cy} x2={b.x} y2={b.y} />)}
      <circle class="hubnode" cx={cx} cy={cy} r="17" />
      <text class="hublabel" x={cx} y={cy + 4}>Raast</text>
    </g>
    {
      banks.map((b) => (
        <g class="bank">
          <circle cx={b.x} cy={b.y} r="13" />
          <text x={b.x} y={b.y + 4}>{b.name}</text>
        </g>
      ))
    }
  </svg>

  <figcaption>
    <span class="count mesh-count"><b>15</b> direct links</span>
    <span class="count star-count"><b>6</b> links to one hub</span>
    <span class="note">With 20 banks: 190 links without a hub, 20 with one.</span>
  </figcaption>
</figure>

<style>
  .hub {
    display: grid;
    gap: 10px;
    padding: 16px 18px 18px;
  }

  .toggle {
    display: inline-flex;
    justify-self: start;
    padding: 3px;
    border: 1px solid var(--stroke);
    border-radius: 999px;
  }

  input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  label {
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--mut);
    cursor: pointer;
  }

  input:checked + label {
    background: var(--ink);
    color: var(--bg);
  }

  input:focus-visible + label {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  svg {
    width: 100%;
    height: auto;
  }

  line {
    stroke-width: 1.4;
    transition: opacity 0.4s;
  }

  .mesh line {
    stroke: var(--c-bank);
    stroke-opacity: 0.55;
  }

  .star line {
    stroke: var(--c-raast);
    stroke-opacity: 0.8;
  }

  .star {
    opacity: 0;
    transition: opacity 0.4s;
  }

  .hubnode {
    fill: color-mix(in srgb, var(--c-raast) 22%, var(--bg));
    stroke: var(--c-raast);
    stroke-width: 1.5;
  }

  .hublabel {
    fill: var(--ink);
    font-size: 9px;
    font-weight: 900;
    text-anchor: middle;
  }

  .bank circle {
    fill: color-mix(in srgb, var(--c-bank) 20%, var(--bg));
    stroke: var(--c-bank);
    stroke-width: 1.5;
  }

  .bank text {
    fill: var(--ink);
    font-size: 11px;
    font-weight: 900;
    text-anchor: middle;
  }

  .hub:has(#hub-star:checked) .mesh {
    opacity: 0;
  }

  .hub:has(#hub-star:checked) .star {
    opacity: 1;
  }

  .mesh {
    transition: opacity 0.4s;
  }

  figcaption {
    display: grid;
    gap: 2px;
  }

  .count {
    font-size: 1rem;
    font-weight: 800;
    color: var(--mut);
  }

  .count b {
    font-size: 1.9rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin-right: 4px;
  }

  .star-count,
  .hub:has(#hub-star:checked) .mesh-count {
    display: none;
  }

  .hub:has(#hub-star:checked) .star-count {
    display: block;
  }

  .note {
    font-size: 0.8rem;
    color: var(--faint);
  }
</style>
