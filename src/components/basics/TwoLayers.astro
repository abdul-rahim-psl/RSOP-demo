---
const banks = [
  { x: 110, n: 'A' },
  { x: 250, n: 'B' },
  { x: 390, n: 'C' },
  { x: 530, n: 'D' },
];
// Payments clearing between banks in the top layer: arcs above the bank row.
const hops = [
  { d: 'M110 66 Q180 26 250 66', dur: 2.6, begin: 0, c: 'bank' },
  { d: 'M530 66 Q460 26 390 66', dur: 2.2, begin: 0.7, c: 'raast' },
  { d: 'M250 66 Q320 18 390 66', dur: 3, begin: 1.4, c: 'rsop' },
  { d: 'M390 66 Q250 0 110 66', dur: 3.4, begin: 0.3, c: 'customer' },
  { d: 'M250 66 Q390 4 530 66', dur: 3.2, begin: 2, c: 'biller' },
];
---

<figure class="layers glass">
  <svg viewBox="0 0 640 330" role="img" aria-label="Two layers: payments clear one by one in Raast; at each cut-off one net amount per bank settles in PRISM+">
    <rect class="band" x="8" y="8" width="624" height="128" rx="16" />
    <text class="blabel" x="26" y="32">RAAST · CLEARING</text>
    <text class="bclock" x="614" y="32">seconds · 24x7</text>
    {hops.map((h) => <path class="hop" d={h.d} />)}
    <g class="moving">
      {
        hops.map((h) => (
          <circle r="4" fill={`var(--c-${h.c})`}>
            <animateMotion dur={`${h.dur}s`} begin={`${h.begin}s`} repeatCount="indefinite" path={h.d} />
          </circle>
        ))
      }
    </g>
    {
      banks.map((b) => (
        <g class="bank">
          <circle cx={b.x} cy="84" r="17" />
          <text x={b.x} y="89">{b.n}</text>
          <text class="pos" x={b.x} y="120">position</text>
        </g>
      ))
    }

    <line class="cut" x1="20" y1="168" x2="620" y2="168" />
    <rect class="cutpill" x="268" y="156" width="104" height="24" rx="12" />
    <text class="cuttext" x="320" y="172">CUT-OFF</text>

    <g class="batch">
      <rect x="250" y="108" width="140" height="30" rx="10" />
      <text x="320" y="128">one net amount per bank</text>
      <animateTransform attributeName="transform" type="translate" values="0 0; 0 0; 0 104; 0 104" keyTimes="0; 0.45; 0.75; 1" dur="6s" repeatCount="indefinite" />
      <animate attributeName="opacity" values="0; 1; 1; 0" keyTimes="0; 0.4; 0.8; 1" dur="6s" repeatCount="indefinite" />
    </g>

    <rect class="band settle" x="8" y="194" width="624" height="128" rx="16" />
    <text class="blabel" x="26" y="218">PRISM+ · SETTLEMENT</text>
    <text class="bclock" x="614" y="218">at cut-offs · business days</text>
    {
      banks.map((b) => (
        <g class="acct">
          <rect x={b.x - 50} y="246" width="100" height="44" rx="10" />
          <text x={b.x} y="266">Bank {b.n}</text>
          <text class="sub" x={b.x} y="281">account at SBP</text>
        </g>
      ))
    }
  </svg>
  <figcaption>
    <span><b>Top:</b> payments clear one by one, in seconds, day and night. Raast only keeps a running total, a <b>position</b>, for each bank.</span>
    <span><b>Bottom:</b> at each cut-off, one net amount per bank settles in PRISM+, all together or not at all. Now the
    money has really moved.</span>
  </figcaption>
</figure>

<style>
  .layers {
    display: grid;
    gap: 12px;
    padding: 14px 16px 16px;
  }

  svg {
    width: 100%;
    height: auto;
  }

  .band {
    fill: color-mix(in srgb, var(--c-raast) 6%, transparent);
    stroke: color-mix(in srgb, var(--c-raast) 40%, transparent);
  }

  .band.settle {
    fill: color-mix(in srgb, var(--c-prism) 7%, transparent);
    stroke: color-mix(in srgb, var(--c-prism) 50%, transparent);
  }

  .blabel {
    fill: var(--ink-2);
    font-size: 10.5px;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .bclock {
    fill: var(--mut);
    font-size: 10.5px;
    font-weight: 700;
    text-anchor: end;
  }

  .hop {
    fill: none;
    stroke: var(--stroke-strong);
    stroke-dasharray: 2 5;
  }

  .bank circle {
    fill: color-mix(in srgb, var(--c-bank) 20%, var(--bg));
    stroke: var(--c-bank);
    stroke-width: 1.5;
  }

  .bank text,
  .acct text,
  .batch text,
  .cuttext {
    fill: var(--ink);
    font-size: 12px;
    font-weight: 900;
    text-anchor: middle;
  }

  .bank .pos {
    fill: var(--faint);
    font-size: 9.5px;
    font-weight: 700;
  }

  .cut {
    stroke: var(--accent);
    stroke-width: 1.4;
    stroke-dasharray: 6 5;
  }

  .cutpill {
    fill: var(--bg);
    stroke: var(--accent);
  }

  .cuttext {
    font-size: 10.5px;
    letter-spacing: 0.12em;
  }

  .batch rect {
    fill: color-mix(in srgb, var(--c-prism) 30%, var(--bg));
    stroke: var(--c-prism);
  }

  .batch text {
    font-size: 10.5px;
  }

  .acct rect {
    fill: color-mix(in srgb, var(--c-prism) 12%, var(--bg));
    stroke: color-mix(in srgb, var(--c-prism) 70%, transparent);
  }

  .acct .sub {
    fill: var(--mut);
    font-size: 9.5px;
    font-weight: 700;
  }

  figcaption {
    display: grid;
    gap: 6px;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  figcaption b {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .moving {
      display: none;
    }
  }
</style>
