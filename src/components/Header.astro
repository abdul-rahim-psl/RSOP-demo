---
import ThemeToggle from './ThemeToggle.astro';
import { chapters, glossaryLink } from '../data/chapters';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [...chapters.map((c) => ({ href: c.href, n: c.n, label: c.nav })), { ...glossaryLink, n: '', label: glossaryLink.nav }];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Bill pay, explained: home">
    <svg class="mark" viewBox="0 0 44 22" aria-hidden="true">
      <path d="M4 16 Q12 4 22 6 T40 16" fill="none" stroke="currentColor" stroke-opacity=".35" stroke-width="1.4" />
      <circle cx="4" cy="16" r="3" fill="var(--c-customer)" />
      <circle cx="12" cy="8.6" r="3" fill="var(--c-bank)" />
      <circle cx="22" cy="6" r="3.4" fill="var(--c-raast)" />
      <circle cx="32" cy="8.6" r="3" fill="var(--c-rsop)" />
      <circle cx="40" cy="16" r="3" fill="var(--c-biller)" />
    </svg>
    <span class="word">Bill pay, <em>explained</em></span>
  </a>

  <nav class="nav" aria-label="Chapters">
    {
      links.map((l) => (
        <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
          {l.n && <span class="n mono">{l.n}</span>}
          {l.label}
        </a>
      ))
    }
  </nav>

  <div class="tools">
    <button class="menu-btn" type="button" popovertarget="chapter-menu" aria-label="Chapters">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" /></svg>
      <span>Chapters</span>
    </button>
    <ThemeToggle />
  </div>
</header>

<div id="chapter-menu" class="menu glass" popover>
  <p class="seclabel">Chapters</p>
  <a href="/" aria-current={path === '/' ? 'page' : undefined}><span class="n mono">00</span>Start here</a>
  {
    links.map((l) => (
      <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
        <span class="n mono">{l.n || '··'}</span>
        {l.label}
      </a>
    ))
  }
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 20px;
    height: var(--header-h);
    padding: 0 var(--gutter);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--stroke);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    flex: 0 0 auto;
  }

  .mark {
    width: 40px;
    height: 20px;
    color: var(--ink);
  }

  .word {
    font-weight: 900;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .word em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 1.12em;
    letter-spacing: 0;
  }

  .nav {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }

  .nav a,
  .menu a {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 7px 12px;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--mut);
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      color 0.15s,
      background 0.15s;
  }

  .nav a:hover,
  .menu a:hover {
    color: var(--ink);
    background: var(--hover);
  }

  .nav a[aria-current='page'],
  .menu a[aria-current='page'] {
    color: var(--ink);
    border-color: var(--stroke-strong);
    background: var(--raised);
  }

  .n {
    font-size: 0.7rem;
    color: var(--faint);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .menu-btn {
    display: none;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 14px;
    border: 1px solid var(--stroke);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 800;
    cursor: pointer;
  }

  .menu-btn svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .menu {
    inset: calc(var(--header-h) + 8px) var(--gutter) auto auto;
    width: min(300px, calc(100vw - 2 * var(--gutter)));
    margin: 0;
    padding: 14px 10px 10px;
    color: var(--ink);
    box-shadow: var(--shadow);
  }

  .menu .seclabel {
    margin: 0 8px 8px;
  }

  .menu a {
    display: flex;
    width: 100%;
    padding: 9px 10px;
    border-radius: 10px;
    font-size: 0.95rem;
  }

  @media (max-width: 1080px) {
    .nav {
      display: none;
    }

    .tools {
      margin-left: auto;
    }

    .menu-btn {
      display: inline-flex;
    }
  }

  @media (max-width: 420px) {
    .menu-btn span {
      display: none;
    }

    .menu-btn {
      padding: 0 10px;
    }
  }
</style>
