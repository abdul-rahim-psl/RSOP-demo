---
interface Props {
  items: { id: string; label: string }[];
  title?: string;
}

const { items, title = 'In this chapter' } = Astro.props;
---

<nav class="toc" aria-label={title} data-toc>
  <p class="seclabel">{title}</p>
  <ol>
    {
      items.map((it, i) => (
        <li>
          <a href={`#${it.id}`} data-toc-link={it.id}>
            <span class="i mono">{String(i + 1).padStart(2, '0')}</span>
            {it.label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  // Marks the section being read, like a curriculum outline.
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((a) => links.set(a.dataset.tocLink!, a));
  const seen = new Set<string>();
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => (e.isIntersecting ? seen.add(e.target.id) : seen.delete(e.target.id)));
      const first = [...links.keys()].find((id) => seen.has(id));
      links.forEach((a, id) => a.toggleAttribute('data-on', id === first));
    },
    { rootMargin: '-30% 0px -55% 0px' },
  );
  links.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) io.observe(el);
  });
</script>

<style>
  .toc {
    position: sticky;
    top: calc(var(--header-h) + 28px);
    display: grid;
    gap: 10px;
    align-self: start;
  }

  ol {
    display: grid;
    gap: 2px;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--stroke);
  }

  a {
    display: flex;
    gap: 10px;
    margin-left: -1px;
    padding: 6px 0 6px 14px;
    border-left: 2px solid transparent;
    color: var(--mut);
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  a:hover {
    color: var(--ink);
  }

  a[data-on] {
    color: var(--ink);
    border-left-color: var(--accent);
  }

  .i {
    font-size: 0.7rem;
    color: var(--faint);
    padding-top: 2px;
  }
</style>
