---
import ActorIcon from './ActorIcon.astro';

interface Props {
  name: string;
  role: string;
  icon: 'raast' | 'prism';
  color: string;
  big: string;
  unit: string;
  sub?: string;
  facts: [string, string][];
  source: string;
}

const { name, role, icon, color, big, unit, sub, facts, source } = Astro.props;
---

<div class="fact glass" style={`--c: var(--c-${color})`}>
  <div class="top">
    <span class="disc"><ActorIcon actor={icon} size={18} /></span>
    <div>
      <p class="nm">{name}</p>
      <p class="rl">{role}</p>
    </div>
  </div>
  <div class="big">
    <span class="n">{big}</span>
    <span class="u">{unit}</span>
  </div>
  {sub && <p class="sub">{sub}</p>}
  <dl>
    {
      facts.map(([k, v]) => (
        <div>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </div>
      ))
    }
  </dl>
  <p class="src">Source: {source}</p>
</div>

<style>
  .fact {
    display: grid;
    gap: 12px;
    padding: 16px 18px 16px;
  }

  .top {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .disc {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1.5px solid var(--c);
    border-radius: 50%;
    background: color-mix(in srgb, var(--c) 16%, var(--bg));
    box-shadow: 0 0 24px color-mix(in srgb, var(--c) 35%, transparent);
  }

  .nm {
    font-size: 1.05rem;
    font-weight: 900;
  }

  .rl {
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .big {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
  }

  .big .n {
    font-size: 2.4rem;
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .big .u {
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--mut);
  }

  .sub {
    margin-top: -6px;
    font-size: 0.86rem;
    color: var(--ink-2);
  }

  dl {
    display: grid;
    border: 1px solid var(--stroke);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  dl div {
    display: grid;
    grid-template-columns: 8.5em 1fr;
    gap: 10px;
    padding: 8px 12px;
    font-size: 0.84rem;
  }

  dl div + div {
    border-top: 1px solid var(--stroke);
  }

  dt {
    color: var(--mut);
    font-weight: 700;
  }

  .src {
    font-size: 0.72rem;
    color: var(--faint);
  }
</style>
